<?xml version="1.0" encoding="utf-8"?>
<!-- En desarrollo los servicios corren por http en la máquina (10.0.2.2 desde el emulador).
     Solo ese host puede usar cleartext; el resto sigue exigiendo https. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
